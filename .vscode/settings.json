{
    "files.exclude": {
        "**/.DS_Store": true,
        "**/.git": true,
        "**/.vs": true,
        "**/.gitmodules": true,
        "**/.vsconfig": true,
        "**/*.booproj": true,
        "**/*.pidb": true,
        "**/*.suo": true,
        "**/*.user": true,
        "**/*.userprefs": true,
        "**/*.unityproj": true,
        "**/*.dll": true,
        "**/*.exe": true,
        "**/*.pdf": true,
        "**/*.mid": false,
        "**/*.midi": false,
        "**/*.wav": false,
        "**/*.gif": false,
        "**/*.ico": false,
        "**/*.jpg": false,
        "**/*.jpeg": false,
        "**/*.png": false,
        "**/*.psd": false,
        "**/*.tga": false,
        "**/*.tif": false,
        "**/*.tiff": false,
        "**/*.3ds": false,
        "**/*.3DS": false,
        "**/*.fbx": false,
        "**/*.FBX": false,
        "**/*.lxo": false,
        "**/*.LXO": false,
        "**/*.ma": false,
        "**/*.MA": false,
        "**/*.obj": false,
        "**/*.OBJ": false,
        "**/*.asset": false,
        "**/*.cubemap": false,
        "**/*.flare": false,
        "**/*.mat": false,
        "**/*.meta": false,
        "**/*.prefab": false,
        "**/*.unity": false,
        "build/": true,
        "Build/": true,
        "Library/": true,
        "library/": true,
        "obj/": true,
        "Obj/": true,
        "Logs/": true,
        "logs/": true,
        "ProjectSettings/": true,
        "UserSettings/": true,
        "temp/": true,
        "Temp/": true
    },
    "files.associations": {
        "*.asset": "yaml",
        "*.meta": "yaml",
        "*.prefab": "yaml",
        "*.unity": "yaml",
    },
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "*.sln": "*.csproj",
        "*.slnx": "*.csproj"
    },
    "dotnet.defaultSolution": "OceanoVerde.slnx"
}